# WhaleToDo 后端环境变量模板（复制为 .env 后按需修改；不要提交真实秘密）
# 说明：本文件不含任何真实凭据，可用于本地开发与团队评审。

# 运行环境：development | test | demo | production
NODE_ENV=development

# 监听地址（本地开发只绑回环；部署时由反向代理转发）
HOST=127.0.0.1
PORT=8080

# 业务日时区（签到等按此生成 business_date），必须可配置
BUSINESS_TIMEZONE=Asia/Shanghai

# 客户端使用的 API 基址（仅用于 /meta 自描述与文档；客户端自己的基址另行可配置）
PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1

# 信任的反向代理：false | 127.0.0.1 | 逗号分隔 IP/网段（只填回环或实际 Nginx 地址，不要盲目 true）
TRUST_PROXY=false

# 支付通道：disabled | mock | real
# 约束：mock 只允许 NODE_ENV=test|demo；production 下配置 mock 会拒绝启动
PAYMENT_PROVIDER=disabled

# 仅当 PAYMENT_PROVIDER=mock 时必填：服务端内部校验模拟支付回调的令牌
# MOCK_WEBHOOK_TOKEN=

# SMTP 验证码投递（例如 QQ 邮箱）：HOST/PORT/SECURE/USER/PASS 全部存在才启用；
# SMTP_FROM 默认等于 SMTP_USER。SMTP 与 DEMO_EMAIL_OUTBOX 互斥。
# 不要把授权码/密码提交到仓库或贴到 PR/聊天。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# 下一阶段接入 Prisma 后使用（当前内存仓储不需要）
# DATABASE_URL=postgresql://whaletodo_app:CHANGE_ME@127.0.0.1:5432/whaletodo
