# Non-secret model, request transport and billing settings. No call, daily token or concurrency quotas.
AI_PORT=8081
DEEPSEEK_MODEL=deepseek-flash
AI_MAX_OUTPUT=16384
AI_TIMEOUT_MS=45000
BUSINESS_TIMEZONE=Asia/Shanghai

# Pilot calibration from real synthetic user tasks; cumulative ceiling per user and frozen rate.
# Integer wallet: short requests may settle 0 or 1 point; unused reservation is refunded.
AI_TOKENS_PER_POINT=3200
AI_BILLING_STRATEGY=cumulative_tokens
# Keep disabled until the account/entitlement bridge is reviewed and deployed.
AI_EDIT_ENABLED=false
DEEPSEEK_EDIT_MODEL=deepseek-v4-pro
